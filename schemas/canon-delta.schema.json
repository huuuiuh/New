{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/canon-delta.schema.json",
  "title": "Canon Delta",
  "description": "Proposed (extractor output) or reconciled/verified set of canon changes extracted from one approval-locked manuscript version (FR-7.2, ADR-0037). Items are proposals, not truth; canon.commit_delta applies the verified delta atomically and marks the manuscript version accepted in the same transaction.",
  "type": "object",
  "required": [
    "project_id",
    "chapter_id",
    "manuscript_version_id",
    "base_canon_version",
    "stage",
    "items",
    "summary_l1"
  ],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "chapter_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "manuscript_version_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The approval-locked (status=approved) manuscript version the delta was extracted from"
    },
    "base_canon_version": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "type": "string",
      "enum": [
        "extracted_a",
        "extracted_b",
        "reconciled",
        "verified"
      ]
    },
    "extractor_call_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deltaItem"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypothesis_results": {
      "type": "array",
      "description": "For each contract-planned delta: realized/unrealized with evidence.",
      "items": {
        "type": "object",
        "required": [
          "hypothesis_ref",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "hypothesis_ref": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "realized",
              "partially_realized",
              "unrealized"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidenceRef"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "summary_l1": {
      "type": "string",
      "maxLength": 900,
      "description": "English L1 summary (≤ ~120 words)"
    },
    "ending_hook": {
      "type": "string"
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agreed": {
          "type": "integer"
        },
        "single_source": {
          "type": "integer"
        },
        "conflicts": {
          "type": "integer"
        },
        "adjudicated": {
          "type": "integer"
        },
        "human_queue": {
          "type": "integer"
        },
        "rejected_no_evidence": {
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "itemType": {
      "type": "string",
      "enum": [
        "fact",
        "event",
        "knowledge_state",
        "relationship_state",
        "promise_event",
        "proposition",
        "proposition_truth",
        "entity",
        "alias"
      ]
    },
    "op": {
      "type": "string",
      "description": "assert = new row; close = end the story-time validity of an existing row (normal state transition without a replacement value); supersede = close an existing row and assert a replacement (normal state transition); retract = remove an existing row from canon as of this version (correction/retcon/rollback only — never for a normal in-story change); open/advance/pay = promise ledger transitions; create = new entity/alias/proposition (ADR-0038).",
      "enum": [
        "assert",
        "close",
        "supersede",
        "retract",
        "open",
        "advance",
        "pay",
        "create"
      ]
    },
    "deltaItemBase": {
      "type": "object",
      "required": [
        "local_id",
        "type",
        "op",
        "payload",
        "frame",
        "evidence",
        "confidence",
        "importance"
      ],
      "properties": {
        "local_id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/itemType"
        },
        "op": {
          "$ref": "#/$defs/op"
        },
        "payload": {
          "type": "object"
        },
        "frame": {
          "$ref": "common.schema.json#/$defs/realityFrame"
        },
        "story_clock": {
          "$ref": "common.schema.json#/$defs/storyClock"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceRef"
          },
          "minItems": 1
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        "importance": {
          "type": "string",
          "enum": [
            "core",
            "major",
            "minor"
          ]
        },
        "supersedes_ref": {
          "type": "string",
          "description": "Existing canon item id being closed, superseded or retracted (required for op=close|supersede|retract)"
        },
        "reconciliation_status": {
          "type": "string",
          "enum": [
            "agreed",
            "single_source",
            "adjudicated",
            "human_resolved",
            "rejected"
          ]
        },
        "adjudication_call_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidence_ok": {
              "type": "boolean"
            },
            "entities_ok": {
              "type": "boolean"
            },
            "frame_ok": {
              "type": "boolean"
            },
            "validity_ok": {
              "type": "boolean"
            },
            "contradiction": {
              "type": "string",
              "enum": [
                "none",
                "supersedes",
                "unexplained",
                "locked_violation"
              ]
            },
            "leak_check_ok": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "deltaItem": {
      "description": "Discriminated on `type`: the payload must conform to the matching proposal schema in canon-delta-payloads.schema.json.",
      "allOf": [
        {
          "$ref": "#/$defs/deltaItemBase"
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "close",
                  "supersede",
                  "retract"
                ]
              }
            }
          },
          "then": {
            "required": [
              "supersedes_ref"
            ]
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "fact"
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/factProposal"
                },
                "frame": {
                  "$ref": "fact.schema.json#/$defs/factFrame"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "event"
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/eventProposal"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "knowledge_state"
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/knowledgeStateProposal"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "relationship_state"
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/relationshipStateProposal"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "promise_event"
                },
                "op": {
                  "enum": [
                    "open",
                    "advance",
                    "pay"
                  ]
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/promiseEventProposal"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "proposition"
                },
                "op": {
                  "enum": [
                    "create",
                    "retract"
                  ]
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/propositionProposal"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "proposition_truth"
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/propositionTruthProposal"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "entity"
                },
                "op": {
                  "enum": [
                    "create",
                    "retract"
                  ]
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/entityProposal"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "alias"
                },
                "op": {
                  "enum": [
                    "create",
                    "retract"
                  ]
                },
                "payload": {
                  "$ref": "canon-delta-payloads.schema.json#/$defs/aliasProposal"
                }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
